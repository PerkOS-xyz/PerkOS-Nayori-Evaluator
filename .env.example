NODE_ENV=production
PORT=8080
EVALUATOR_ENV=qa
STACKS_NETWORK=testnet
STX_COMMERCE_CONTRACT=ST000000000000000000002AMW42H.agentic-commerce-v5
SBTC_COMMERCE_CONTRACT=ST000000000000000000002AMW42H.sbtc-commerce-v4
EVALUATOR_PRINCIPAL=ST000000000000000000002AMW42H
EVALUATOR_PRIVATE_KEY=replace-with-dedicated-testnet-private-key
EVALUATOR_API_KEY=replace-with-dedicated-internal-service-key
HERMES_API_BASE_URL=https://api.llm.perkos.xyz/nayori-agent-qa
HERMES_API_KEY=replace-with-dedicated-hermes-api-key
PRIMARY_MODEL=kimi-k2.6:cloud
VERIFIER_MODEL=kimi-k2.6:cloud
MIN_DECISION_CONFIDENCE=0.85
STACKS_API_URL=https://api.testnet.hiro.so
TRANSACTION_FEE_USTX=5000
INFERENCE_TIMEOUT_MS=240000
DATABASE_URL=postgresql://nayori:replace-me@postgres/nayori_evaluator_qa

# Default-off QA candidate. Enable only after coordinated rollout and DB race/restart checks.
PUBLIC_COMMITTED_EVALUATIONS=false
PUBLIC_EVALUATIONS_DAILY_LIMIT=10
PUBLIC_EVALUATIONS_QUEUE_LIMIT=5
PUBLIC_EVALUATIONS_MIN_STX=100000
PUBLIC_EVALUATIONS_MIN_SBTC=1000
# Comma-separated operator-owned HTTPS origins, not URLs supplied by jobs. Empty denies all.
EVIDENCE_ALLOWED_ORIGINS=
PRIVATE_EVIDENCE_ENABLED=false
PRIVATE_EVIDENCE_ORIGIN=
PRIVATE_EVIDENCE_OAUTH_CLIENT_FILE=
