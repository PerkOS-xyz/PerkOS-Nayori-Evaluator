# Copy outside Git, populate, and chmod 600. Never add a Stacks or Hermes secret.
# The service file contains host/database/user only; its password stays in the separate .pgpass file.
DATABASE_BACKUP_SERVICE=nayori-evaluator-backup
PGSERVICEFILE=/opt/perkos-nayori/secrets/postgres-services.conf
PGPASSFILE=/opt/perkos-nayori/secrets/postgres.pgpass
S3_BUCKET=replace-with-dedicated-backup-bucket
S3_PREFIX=nayori/evaluator/postgres
AWS_REGION=us-east-1
BACKUP_RECEIPT_DIRECTORY=/opt/perkos-nayori/evaluator/evidence/database-backups
CONFIRM_NAYORI_DATABASE_BACKUP=yes
CONFIRM_NAYORI_DATABASE_RESTORE_DRILL=yes
